# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local a git.
# Con AI_MODE=mock la app funciona sin ninguna clave (respuestas grabadas del caso del hotel).

# --- Modo de IA: live | mock ---
AI_MODE=mock

# --- LLM (https://console.anthropic.com) — fija un límite de gasto mensual ---
ANTHROPIC_API_KEY=

# --- Embeddings (opcional; sin esta clave la búsqueda usa solo texto completo de Postgres) ---
VOYAGE_API_KEY=

# --- Ilustraciones conceptuales (opcional; solo para scripts/generate-illustrations.ts) ---
GEMINI_API_KEY=

# --- Supabase (https://supabase.com/dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel /panel: correos autorizados, separados por comas ---
STAFF_EMAILS=

# --- Protección de la URL pública ---
RATE_LIMIT_MAX_MESSAGES=20
# Per-IP budget: much higher, because a whole room on campus Wi-Fi shares one IP
RATE_LIMIT_IP_MAX=200
RATE_LIMIT_WINDOW_MINUTES=10
DAILY_CONVERSATION_CAP=300

# --- Secrets for guardrails (generate with: openssl rand -hex 32) ---
TOOL_APPROVAL_SECRET=
RATE_LIMIT_SALT=
